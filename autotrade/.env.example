# ==========================================================================
#  autotrade 설정 예시
#  cp .env.example .env  후 값을 채우고  chmod 600 .env
#  ⚠️ .env 는 절대 git 에 커밋하지 않는다 (.gitignore 로 막혀 있음)
# ==========================================================================

# --------------------------------------------------------------- 실행 모드
#  paper      : 오프라인 시뮬레이터 (네트워크·계좌 불필요, 기본값)
#  kis-paper  : 한국투자증권 모의투자 서버 (실제 API, 가상 자금)
#  kis-live   : 한국투자증권 실전투자 (진짜 돈)
#  meritz     : 메리츠증권 (공개 API 출시 후 config/meritz.spec.json 을 채워야 동작)
AUTOTRADE_MODE=paper

# 켜져 있으면 주문 직전까지만 가고 전송하지 않는다. 처음에는 반드시 true.
AUTOTRADE_DRY_RUN=true

# 정규장(09:00~15:30) 밖에서는 주문하지 않는다.
AUTOTRADE_TRADE_ONLY_IN_SESSION=true

# 매매 판단 주기(초). 너무 짧으면 API 유량 제한에 걸린다.
AUTOTRADE_POLL_INTERVAL_SEC=30

# ------------------------------------------------------- 리스크 한도 (필수)
# 비워 두면 '모든 종목 차단'이 기본값이다. 거래할 종목만 명시적으로 적는다.
AUTOTRADE_SYMBOL_WHITELIST=

AUTOTRADE_MAX_ORDER_NOTIONAL=300000        # 1주문 최대 금액(원)
AUTOTRADE_MAX_POSITION_NOTIONAL=1000000    # 종목당 최대 보유 평가액(원)
AUTOTRADE_MAX_GROSS_EXPOSURE=3000000       # 전체 보유 상한(원)
AUTOTRADE_DAILY_LOSS_LIMIT=100000          # 일중 손실 한도(원) — 넘으면 당일 전면 중단
AUTOTRADE_MAX_ORDERS_PER_DAY=40
AUTOTRADE_MAX_ORDERS_PER_MINUTE=5
AUTOTRADE_MIN_SECONDS_BETWEEN_SAME_SIGNAL=60

# --------------------------------------------------- 거래비용 (본인 계좌 기준)
# ⚠️ 아래는 예시값이다. 본인 증권사 수수료율·세율로 반드시 교체할 것.
AUTOTRADE_FEE_RATE=0.00015                 # 위탁수수료율
AUTOTRADE_SELL_TAX_RATE=0.0015             # 매도 시 증권거래세+농특세
AUTOTRADE_SLIPPAGE_BPS=5                   # 시뮬레이션 슬리피지(1bp=0.01%)

# ------------------------------------------------- 한국투자증권 (KIS) 자격증명
# KIS Developers(apiportal.koreainvestment.com)에서 발급.
# 실전용 앱키와 모의투자용 앱키는 별개다. 섞어 쓰면 인증이 실패한다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                            # 계좌번호 앞 8자리
KIS_ACCOUNT_PD=01                          # 계좌 상품코드 뒤 2자리

# TR_ID 는 증권사가 개정할 수 있다. 문서와 다르면 여기서 덮어쓴다.
# KIS_TRID_BUY=
# KIS_TRID_SELL=
# KIS_TRID_BALANCE=
# KIS_MAX_CALLS_PER_SEC=2

# ------------------------------------------------------------ 메리츠증권
# 공개 API 출시 후 발급받은 값. (2026-09 기준 개인용 공개 API 미확인)
MERITZ_APP_KEY=
MERITZ_APP_SECRET=
MERITZ_ACCOUNT_NO=
MERITZ_ACCOUNT_PD=

# ---------------------------------------------------------- 실계좌 안전장치
# 실계좌(kis-live / meritz) 모드는 아래 값을 정확히 설정해야만 기동한다.
# 모의투자에서 충분히 검증하기 전에는 절대 켜지 말 것.
# AUTOTRADE_I_UNDERSTAND_REAL_MONEY_RISK=yes-i-accept-full-loss
